local scripts = {
    [10187294555] = "Mine a Mountain"
}

local game = scripts[game.GameId]
if game then
    loadstring(game:HttpGet("https://raw.githubusercontent.com/iMOKAK/FREE/refs/heads/main/"..game..".lua))()
    
else
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "We’re sorry, but this game is not supported. Please check our Discord for a list of supported games",
        Text = "Sorry T_T",
        Duration = 5
    })
    wait(5)
    game:GetService"Players".LocalPlayer:Kick("This game is not supported")
end
